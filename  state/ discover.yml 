name: Group Discovery

on:
  schedule:
    - cron: '0 4 * * *'
  workflow_dispatch:

jobs:
  discover:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: |
          pip install -r requirements.txt
          python -m playwright install --with-deps chromium
      - name: Run discovery
        env:
          FB_COOKIES: ${{ secrets.FB_COOKIES_1 }}
        run: python discover.py
      - name: Commit groups
        run: |
          git config user.name "asp-bot"
          git config user.email "bot@users.noreply.github.com"
          git add groups.txt || true
          git diff --cached --quiet || git commit -m "discovery: update groups" || true
          git push || true
